<details class="embed-pdf-wrapper">
    <summary class="embed-pdf-header">
        <div class="embed-pdf-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>{{ title | default("PDF Document") }}</span>
            <span class="embed-pdf-hint">Click to expand <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
        </div>
        <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="embed-pdf-download" download>Download &darr;</a>
    </summary>
    <div class="embed-pdf-body">
        <iframe src="{{ url }}" type="application/pdf" width="100%" height="100%" frameborder="0">Your browser does not support PDF preview.</iframe>
    </div>
</details>